{
  "buildCommand": "pnpm --filter @workspace/thumblab run build",
  "outputDirectory": "artifacts/thumblab/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production",
    "BASE_PATH": "/",
    "PORT": "3000"
  }
}
